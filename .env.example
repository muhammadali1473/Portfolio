# ────────────────────────────────────────────────────────────────
# Server-only (required for the AI demos)
# Create a free Groq API key at https://console.groq.com/keys
# ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# Optional: override the default model
GROQ_MODEL=llama-3.3-70b-versatile

# ────────────────────────────────────────────────────────────────
# Optional: unauthenticated GitHub API is rate-limited to 60 req/hr.
# Add a read-only personal access token (scope: public_repo, read:user)
# to raise the limit. Not required — the /api/github route falls back
# to a curated static list if the API is unreachable.
# ────────────────────────────────────────────────────────────────
GITHUB_TOKEN=

# ────────────────────────────────────────────────────────────────
# Server-only (required for the contact form)
# Create a Resend API key at https://resend.com/api-keys
# For production you also need a verified sending domain.
# ────────────────────────────────────────────────────────────────
